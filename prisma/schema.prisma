// دنگ‌حساب — اسکیمای دیتابیس
// داده‌ها روی سرور ذخیره می‌شن (نه مرورگر).
// لوکال: SQLite | پروداکشن (نتلیفای): PostgreSQL — اسکریپت scripts/setup-db.mjs
// بر اساس DATABASE_URL به‌طور خودکار provider را عوض می‌کند.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id        String               @id @default(cuid())
  name      String               @unique
  createdAt DateTime             @default(now())

  paidExpenses   Expense[]            @relation("ExpensePayer")
  participations ExpenseParticipant[]
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Int
  splitType String // "equal" | "custom"
  payerId   String
  createdAt DateTime @default(now())

  payer         Member               @relation("ExpensePayer", fields: [payerId], references: [id])
  participations ExpenseParticipant[]
}

model ExpenseParticipant {
  id          String  @id @default(cuid())
  expenseId   String
  memberId    String
  shareAmount Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
}

# دنگ‌حساب — متغیرهای محیطی لوکال
# این فایل رو به .env کپی کن:  cp .env.example .env

# دیتابیس لوکال (SQLite) — مسیر نسبت به پوشه‌ی prisma/ هست.
DATABASE_URL="file:../db/custom.db"

# برای اتصال به PostgreSQL (لوکال یا ابری مثل neon.tech) این خط رو جایگزین کن:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
